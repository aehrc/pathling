                    "path": "linkId",
                    "type": "string"
                  }
                ]
              },
              {
                "column": [
                  {
                    "name": "text",
                    "path": "text",
                    "type": "string"
                  }
                ]
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "linkId", "text"],
      "expect": []
    },
    {
      "title": "forEachOrNull on a recursive path that exits the schema",
      "description": "forEachOrNull traversal that walks the recursive item element one step past the encoder's nesting limit. The path is treated as an empty collection, so each resource produces a single row with null values for the forEachOrNull columns.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEachOrNull": "item.item.item.item.item",
            "column": [
              {
                "name": "linkId",
                "path": "linkId",
                "type": "string"
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "linkId"],
      "expect": [
        {
          "id": "q1",
          "linkId": null
        },
        {
          "id": "q-wide",
          "linkId": null
        }
      ]
    },
    {
      "title": "forEachOrNull that exits the schema with a collection column",
      "description": "Same as the previous test but the forEachOrNull has a collection column alongside the sibling id column. The null row produced for the empty collection must not violate the nullability of the collection column.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEachOrNull": "item.item.item.item.item",
            "column": [
              {
                "name": "linkIds",
                "path": "linkId",
                "type": "string",
                "collection": true
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "linkIds"],
      "expect": [
        {
          "id": "q1",
          "linkIds": null
        },
        {
          "id": "q-wide",
          "linkIds": null
        }
      ]
    },
    {
      "title": "nested forEachOrNull that exits the schema",
      "description": "An outer forEach at the deepest encoded level contains a forEachOrNull whose path exits the schema. The inner path is resolved inside the outer forEach's lambda. The outer rows are retained, with null values for the inner columns.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEach": "item.item.item.item",
            "select": [
              {
                "column": [
                  {
                    "name": "parentLinkId",
                    "path": "linkId",
                    "type": "string"
                  }
                ]
              },
              {
                "forEachOrNull": "item",
                "column": [
                  {
                    "name": "childLinkId",
                    "path": "linkId",
                    "type": "string"
                  }
                ]
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "parentLinkId", "childLinkId"],
      "expect": [
        {
          "id": "q1",
          "parentLinkId": "g1.1.1.1",
          "childLinkId": null
        },
        {
          "id": "q-wide",
          "parentLinkId": "g1.1.1.1",
          "childLinkId": null
        }
      ]
    },
    {
      "title": "unionAll of forEach branches inside and outside the schema",
      "description": "One unionAll branch iterates the deepest encoded items and the other exits the schema. The empty branch must have the same element type as the populated branch, including for a column without a type annotation, so that the branches can be concatenated.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "unionAll": [
              {
                "forEach": "item.item.item.item",
                "column": [
                  {
                    "name": "linkId",
                    "path": "linkId",
                    "type": "string"
                  },
                  {
                    "name": "itemType",
                    "path": "type"
                  }
                ]
              },
              {
                "forEach": "item.item.item.item.item",
                "column": [
                  {
                    "name": "linkId",
                    "path": "linkId",
                    "type": "string"
                  },
                  {
                    "name": "itemType",
                    "path": "type"
                  }
                ]
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "linkId", "itemType"],
      "expect": [
        {
          "id": "q1",
          "linkId": "g1.1.1.1",
          "itemType": "string"
        },
        {
          "id": "q-wide",
          "linkId": "g1.1.1.1",
          "itemType": "string"
        }
      ]
    },
    {
      "title": "column on a recursive path that exits the schema",
      "description": "Columns whose paths walk the recursive item element one step past the encoder's nesting limit. The path is treated as an empty collection: the singular column is null, the collection column is empty, and every resource still produces a row. The collection column has no type annotation, so its type is inferred from the path.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              },
              {
                "name": "deepLinkId",
                "path": "item.item.item.item.item.linkId.first()",
                "type": "string"
              },
              {
                "name": "deepLinkIds",
                "path": "item.item.item.item.item.linkId",
                "collection": true
              }
            ]
          }
        ]
      },
      "expectColumns": ["id", "deepLinkId", "deepLinkIds"],
      "expect": [
        {
          "id": "q1",
          "deepLinkId": null,
          "deepLinkIds": []
        },
        {
          "id": "q-wide",
          "deepLinkId": null,
          "deepLinkIds": []
        }
      ]
    },
