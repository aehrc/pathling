    {
      "title": "functions on a path that exits the schema",
      "description": "Inside a forEach over the deepest encoded items, functions applied to the next level of item see an empty collection, exactly as they would if the data were absent.",
      "view": {
        "resource": "Questionnaire",
        "status": "active",
        "select": [
          {
            "column": [
              {
                "name": "id",
                "path": "id",
                "type": "id"
              }
            ]
          },
          {
            "forEach": "item.item.item.item",
            "column": [
              {
                "name": "childExists",
                "path": "item.exists()",
                "type": "boolean"
              },
              {
                "name": "childEmpty",
                "path": "item.empty()",
                "type": "boolean"
              },
              {
                "name": "childCount",
                "path": "item.count()",
                "type": "integer"
              },
              {
                "name": "linkIds",
                "path": "linkId | item.linkId",
                "type": "string",
                "collection": true
              }
            ]
          }
        ]
      },
      "expectColumns": [
        "id",
        "childExists",
        "childEmpty",
        "childCount",
        "linkIds"
      ],
      "expect": [
        {
          "id": "q1",
          "childExists": false,
          "childEmpty": true,
          "childCount": 0,
          "linkIds": ["g1.1.1.1"]
        },
        {
          "id": "q-wide",
          "childExists": false,
          "childEmpty": true,
          "childCount": 0,
          "linkIds": ["g1.1.1.1"]
        }
      ]
