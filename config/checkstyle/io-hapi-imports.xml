<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Bans HAPI's parser and FHIR context from the routes that read and write FHIR in this module
    (FR-061, ADR-0004, ticket 32). XML, bundles and JSON are parsed and written by Spark and by
    streaming passes of the module's own, and HAPI is the source of the structural definitions only,
    which reach this module through fhir-schema. The tests may use HAPI as an oracle, so the check
    applies to the main sources alone.
-->
<module name="Checker">

  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <module name="IllegalImport">
      <property name="id" value="NoHapiParserImports"/>
      <property name="illegalPkgs" value="ca.uhn.fhir.parser, ca.uhn.fhir.context, org.hl7.fhir.r4.formats"/>
      <message key="import.illegal"
        value="Illegal import - {0}. FR-061: no ingest or egress route may parse into or build a FHIR object, HAPI included."/>
    </module>
  </module>

</module>
