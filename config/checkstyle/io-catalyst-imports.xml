<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Bans internal Spark Catalyst API from the new encoding code (FR-049).

    The prohibition cannot be expressed as a banned dependency, because the encoding is built from
    column expressions and therefore needs spark-sql, which is the artifact that carries the
    Catalyst classes. Enforcement is at the level of imports instead.

    This configuration is referenced only by the `io` module, as a second execution of the
    Checkstyle plugin alongside the shared `config/checkstyle/checkstyle.xml`. It is deliberately
    not part of the shared configuration, which applies to every module: `encoders` is required by
    FR-051 to retain its Catalyst imports unchanged.
 -->

<module name="Checker">

  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <module name="IllegalImport">
      <property name="id" value="NoCatalystImports"/>
      <property name="illegalPkgs" value="org.apache.spark.sql.catalyst"/>
      <message key="import.illegal"
        value="Illegal import - {0}. FR-049: the new encoding code must not reference internal Spark Catalyst API."/>
    </module>
  </module>

</module>
