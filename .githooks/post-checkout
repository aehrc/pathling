#!/bin/bash
#
# Post-checkout hook that links a linked worktree's .local directory to the main checkout's, so
# that every checkout of the repository shares the same untracked files at the same path. Git runs
# it when "git worktree add" checks out the new worktree, and on every later checkout, where it
# does nothing once the link exists. See docs/agents/local-and-worktrees.md.
#

# The first entry of the worktree list is the main checkout. In a bare repository, and in a
# separate git directory on some versions of git, it is the git directory instead, which has no
# checkout to share .local from. Git sets GIT_DIR for hooks, so it is unset to inspect that entry.
list=$(git worktree list --porcelain) || exit 0
main=$(cd "$(sed -n '1s/^worktree //p' <<< "$list")" && pwd -P) || exit 0
[ "$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$main" rev-parse --is-inside-work-tree 2> /dev/null)" = true ] || exit 0
top=$(cd "$(git rev-parse --show-toplevel)" && pwd -P) || exit 0
[ "$top" = "$main" ] && exit 0

# A branch whose .gitignore predates the link matches only a .local directory, so the link is also
# excluded in info/exclude, which every checkout of the repository reads.
exclude="$(git rev-parse --git-common-dir)/info/exclude"
if ! grep -qsx '/.local' "$exclude"; then
  mkdir -p "$(dirname "$exclude")" && echo '/.local' >> "$exclude"
fi

if [ ! -e "$top/.local" ] && [ ! -L "$top/.local" ]; then
  mkdir -p "$main/.local" && ln -s "$main/.local" "$top/.local"
fi
exit 0
